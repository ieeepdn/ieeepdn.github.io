{
  "name": "ieee-uop-website-pages",
  "version": "1.0.0",
  "private": true,
  "description": "IEEE Student Branch, University of Peradeniya — static edition for GitHub Pages (Next.js static export + Pages CMS + IEEE vTools sync in GitHub Actions)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "media": "node scripts/media.mjs",
    "dev": "npm run media && next dev",
    "build": "npm run media && next build",
    "serve": "npx --yes serve out -l 3000",
    "vtools:sync": "node scripts/vtools-sync.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
